<dialog id="dr-lightbox" aria-label="Photograph viewer">
  <button type="button" class="dr-x" data-close aria-label="Close photograph">Close</button>
  <button type="button" class="dr-step prev" data-step="-1" aria-label="Previous photograph">←</button>
  <figure><img alt="" /><figcaption></figcaption></figure>
  <button type="button" class="dr-step next" data-step="1" aria-label="Next photograph">→</button>
</dialog>
