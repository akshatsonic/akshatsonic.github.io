---
import BaseHead from "../components/BaseHead.astro";
import Fonts from "../components/Fonts.astro";
import Nav from "../components/Nav.astro";
import Foot from "../components/Foot.astro";
import Lightbox from "../components/Lightbox.astro";
import { getCollection } from "astro:content";
import { photographs } from "../data/photographs.js";
import "../styles/portfolio.css";

const posts = (await getCollection("blog", ({ data }) => !import.meta.env.PROD || !data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const fmt = (d: Date) => d.toLocaleDateString("en-US", { month: "short", year: "numeric" });
const featured = [14, 74, 10, 4].map((i) => ({ i, p: photographs[i] }));
const photoData = JSON.stringify(photographs).replace(/</g, "\\u003c");
const social: [string, string][] = [
  ["LinkedIn", "https://linkedin.com/in/akshatsoni"],
  ["GitHub", "https://github.com/akshatsonic"],
  ["X", "https://x.com/akshatsonic"],
];
const projects = [
  {
    number: "01",
    title: "Brief",
    description: "A daily Kindle magazine assembled from your own sources, with an AI editorial pass for selection, summaries, and watchouts.",
    stack: ["Python", "OpenAI", "Chromium"],
    href: "https://github.com/akshatsonic/brief",
    action: "Explore the source",
    visual: "magazine",
  },
  {
    number: "02",
    title: "Aviator",
    description: "An experiment currently taking shape. The repository is the working log for the implementation as it develops.",
    stack: ["Experiment", "In progress"],
    href: "https://github.com/akshatsonic/aviator",
    action: "Explore the source",
    visual: "flight",
  },
  {
    number: "03",
    title: "Bittr",
    description: "An offline, peer-to-peer workspace timeline where posts hop between Android phones over Bluetooth Low Energy.",
    stack: ["Kotlin", "Jetpack Compose", "Bluetooth LE"],
    href: "https://github.com/akshatsonic/bittr",
    action: "Explore the source",
    visual: "mesh",
  },
];
---

<!doctype html>
<html lang="en" data-type="software" data-radius="sharp" data-motion>
  <head>
    <BaseHead title="Akshat Soni — Software engineer and photographer" description="Akshat Soni is a software engineer who photographs festivals and cities after dark, and writes notes on systems along the way." image="/portfolio-assets/instagram-posts/18044205263439212.webp" />
    <meta name="page-type" content="software" />
    <meta name="site-kind" content="software" />
    <Fonts />
  </head>
  <body class="dr">
    <Nav />
    <main>
      <section class="dr-hero">
        <video class="dr-bgvideo" autoplay muted loop playsinline preload="auto" poster="/portfolio-assets/video/hero.jpg" aria-hidden="true" tabindex="-1">
          <source src="/portfolio-assets/video/hero.mp4" type="video/mp4" />
        </video>
        <div class="dr-hero-in">
        <h1 class="dr-h1"><span class="mask"><span>A dust in the cosmos,</span></span><span class="mask"><span>trying to make a difference.</span></span></h1>
        <p class="dr-sub" data-late>Visual storyteller documenting life through a creative lens, architecting resilient backend infrastructure by day, and writing down the lessons found in both.</p>
        <div class="dr-actions" data-late>
          <a class="dr-btn" href="#tinkering">See what I'm building</a>
          <ul class="dr-social">
            {social.map(([t, h]) => <li><a href={h} target="_blank" rel="noopener noreferrer">{t} ↗</a></li>)}
          </ul>
        </div>
        </div>
      </section>

      <section class="dr-sec dr-tinkering" id="tinkering">
        <div class="dr-sec-head">
          <div class="dr-sec-title">
            <h2>Tinkering</h2>
            <p>Small tools and digital spaces built to answer my own questions.</p>
          </div>
          <a class="dr-link" href="https://github.com/akshatsonic?tab=repositories" target="_blank" rel="noopener noreferrer">All projects ↗</a>
        </div>
        <div class="dr-projects">
          {projects.map((project) => (
            <article class="dr-project">
              <div class="dr-project-copy">
                <span class="dr-project-number">{project.number} / project</span>
                <h3>{project.title}</h3>
                <p>{project.description}</p>
                <ul class="dr-project-stack" aria-label="Technologies">
                  {project.stack.map((item) => <li>{item}</li>)}
                </ul>
                <a class="dr-project-link" href={project.href} target={project.href.startsWith("http") ? "_blank" : undefined} rel={project.href.startsWith("http") ? "noopener noreferrer" : undefined}>
                  <span>{project.action}</span><span aria-hidden="true">↗</span>
                </a>
              </div>

              <div class={`dr-project-visual dr-project-visual--${project.visual}`} aria-hidden="true">
                {project.visual === "magazine" && (
                  <div class="dr-magazine">
                    <span class="dr-magazine-kicker">The Brief / Daily edition</span>
                    <b>Your sources,<br />edited for focus.</b>
                    <div><i></i><i></i><i></i></div>
                  </div>
                )}
                {project.visual === "flight" && (
                  <div class="dr-flight">
                    <i></i><i></i><i></i>
                    <b>↗</b>
                    <span>aviator / experiment 02</span>
                  </div>
                )}
                {project.visual === "mesh" && (
                  <div class="dr-phone">
                    <div class="dr-phone-bar"><i></i><span>Bittr / workspace</span><b>•••</b></div>
                    <div class="dr-editor-lines"><strong></strong><span></span><span></span><span></span><span></span></div>
                    <div class="dr-publish"><i></i><span>3 peers nearby</span><b>Sync</b></div>
                  </div>
                )}
                <span class="dr-signal"><i></i></span>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="dr-sec" id="photographs">
        <div class="dr-sec-head">
          <h2 data-reveal>Selected photographs</h2>
          <a class="dr-link" data-reveal data-delay="1" href="/photographs/">All {photographs.length} photographs →</a>
        </div>
        <div class="dr-work">
          {featured.map(({ i, p }, n) => (
            <button type="button" class="dr-card" data-photo={i} data-reveal data-delay={String(n % 2)} aria-label={`Open photograph: ${p.title}. ${p.caption}`}>
              <span class="pic"><img src={p.src} alt="" width={p.width} height={p.height} loading="lazy" decoding="async" /></span>
              <span class="cap"><strong>{p.title}</strong><span>{p.caption}</span></span>
            </button>
          ))}
        </div>
      </section>

      <section class="dr-sec" id="films">
        <div class="dr-sec-head">
          <h2 data-reveal>In motion</h2>
          <p data-reveal data-delay="1">Moving pictures of things I thought looked cooler in my head.</p>
        </div>
        <div class="dr-films">
          <figure data-reveal>
            <video muted loop playsinline preload="none" poster="/portfolio-assets/video/reel-desk.jpg" aria-label="Black and white clip of a coffee cup on a desk and a camera lens cap" data-autoplay>
              <source src="/portfolio-assets/video/reel-desk.mp4" type="video/mp4" />
            </video>
            <figcaption>A desk, a cup, a lens cap.</figcaption>
          </figure>
          <figure data-reveal data-delay="1">
            <video muted loop playsinline preload="none" poster="/portfolio-assets/video/reel-silence.jpg" aria-label="Clips from the travel film Silence: geese on a path, a palace, an elephant carving, a cathedral" data-autoplay>
              <source src="/portfolio-assets/video/reel-silence.mp4" type="video/mp4" />
            </video>
            <figcaption>Silence, a short travel film.</figcaption>
          </figure>
        </div>
      </section>

      <section class="dr-sec" id="writing">
        <div class="dr-sec-head">
          <div class="dr-sec-title">
            <h2 data-reveal>Writing</h2>
            <p data-reveal data-delay="1">Some thoughts made it out of my head and onto the internet.</p>
          </div>
          <a class="dr-link" data-reveal data-delay="2" href="/writing/">All {posts.length} articles →</a>
        </div>
        <ul class="dr-posts">
          {posts.map((post, n) => (
            <li data-reveal data-delay={String(n % 3)}>
              <a href={`/blog/${post.slug}`}>
                <span class="tag">{(post.data.tags?.[0] ?? "note").replace(/_/g, " ")}</span>
                <span class="t">{post.data.title}</span>
                <span class="d">{post.data.description}</span>
                <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="dr-sec dr-about" id="about">
        <div class="dr-about-text">
          <h2 data-reveal>A collection of side quests.</h2>
          <p data-reveal data-delay="1">I build software. Sometimes it works.</p>
          <p data-reveal data-delay="2">The rest of my personality involves books, photography, chai, and developing an unnecessarily deep interest in whatever caught my attention this week.</p>
          <p data-reveal data-delay="3">I made this website because apparently having hobbies wasn't enough. I needed somewhere to put them.</p>
        </div>
        <figure class="dr-portrait" data-reveal data-delay="1">
          <img src="/portfolio-assets/akshat-portrait.png" alt="Akshat smiling" width="500" height="500" loading="lazy" />
        </figure>
      </section>

      <section class="dr-sec dr-chat" id="contact">
        <div class="dr-chat-text">
          <h2 data-reveal>Let's chat.</h2>
          <p data-reveal data-delay="1">Engineering, photographs and the things in between. If you have a problem, a frame or a good cup of chai in mind, say hello.</p>
          <a class="dr-btn" data-reveal data-delay="2" href="https://x.com/akshatsonic" target="_blank" rel="noopener noreferrer">Say hello on X</a>
        </div>
        <dl class="dr-stats" data-reveal data-delay="1">
          <div><dd>{projects.length}</dd><dt>projects</dt></div>
          <div><dd>{photographs.length}</dd><dt>photographs</dt></div>
          <div><dd>{posts.length}</dd><dt>articles</dt></div>
        </dl>
      </section>
    </main>
    <Foot />
    <Lightbox />
    <script is:inline type="application/json" id="ak-photo-data" set:html={photoData}></script>
    <script is:inline src="/portfolio.js" defer></script>
  </body>
</html>
