---
import BaseHead from "../components/BaseHead.astro";
import Fonts from "../components/Fonts.astro";
import Nav from "../components/Nav.astro";
import Foot from "../components/Foot.astro";
import "../styles/portfolio.css";
---

<html lang="en">
  <head>
    <BaseHead title="404 — Page not found" description="This page doesn't exist." />
    <Fonts />
  </head>
  <body class="dr">
    <Nav />
    <main class="dr-hero">
      <img class="dr-bgvideo" src="/portfolio-assets/video/hero.jpg" alt="" width="1280" height="672" />
      <div class="dr-hero-in">
      <h1 class="dr-h1"><span class="mask"><span>Lost in</span></span><span class="mask"><span>the dark.</span></span></h1>
      <p class="dr-sub" data-late>This page doesn't exist. The lit ones are on the home page.</p>
      <div class="dr-actions" data-late><a class="dr-btn" href="/">Back home</a></div>
      </div>
    </main>
    <Foot />
  </body>
</html>
