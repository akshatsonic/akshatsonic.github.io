---
import BaseHead from "../components/BaseHead.astro";
import Fonts from "../components/Fonts.astro";
import Nav from "../components/Nav.astro";
import Foot from "../components/Foot.astro";
import Lightbox from "../components/Lightbox.astro";
import { photographs } from "../data/photographs.js";
import "../styles/portfolio.css";

const photoData = JSON.stringify(photographs).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Photographs — Akshat Soni" description="A few moments, held in light. Photographs by Akshat Soni." image="/portfolio-assets/instagram-posts/18044205263439212.webp" />
    <Fonts />
  </head>
  <body class="dr">
    <Nav current="/photographs/" />
    <main class="dr-page">
      <h1 class="dr-h1"><span class="mask"><span>Less scrolling.</span></span><span class="mask"><span>More seeing.</span></span></h1>
      <p class="dr-sub" data-late>{photographs.length} photographs. Ceremonies, lanes, hillsides and faces, held in light. Tap any frame to open it.</p>
      <div class="dr-grid">
        {photographs.map((p, i) => (
          <button type="button" class="dr-tile" data-reveal={i < 12 ? "" : undefined} data-delay={String(i % 3)} data-photo={i} aria-label={`Open photograph: ${p.title}. ${p.caption}`}>
            <img src={p.src} alt="" width={p.width} height={p.height} loading="lazy" decoding="async" />
            <span>{p.title}</span>
          </button>
        ))}
      </div>
    </main>
    <Foot />
    <Lightbox />
    <script is:inline type="application/json" id="ak-photo-data" set:html={photoData}></script>
    <script is:inline src="/portfolio.js" defer></script>
  </body>
</html>
