---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Fonts from "../components/Fonts.astro";
import Nav from "../components/Nav.astro";
import Foot from "../components/Foot.astro";
import { photographs } from "../data/photographs.js";
import "../styles/portfolio.css";

type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, heroImage, heroImageTitle, readTime } = Astro.props;
// A different photograph of mine behind each post, chosen from the title.
const pool = [0, 2, 3, 4, 5, 6, 7, 8, 10, 11, 9, 1];
const seed = [...title].reduce((a, c) => a + c.charCodeAt(0), 0);
const bg = photographs[pool[seed % pool.length]].src;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={heroImage} />
    <Fonts />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.21/dist/katex.min.css" />
  </head>
  <body class="dr blog-article" style={`--bgimg: url(${bg})`}>
    <Nav current="/#writing" />
    <main class="post">
      <article>
        <h1><span class="mask"><span>{title}</span></span></h1>
        <p class="post-meta" data-late>
          <time datetime={pubDate.toISOString()}>{pubDate.toLocaleDateString("en-us", { year: "numeric", month: "long", day: "numeric" })}</time>
          {readTime && <span>{readTime} read</span>}
        </p>
        {heroImage && (
          <figure class="post-hero" data-late>
            <img src={heroImage} alt={title} />
            {heroImageTitle && <figcaption set:html={heroImageTitle} />}
          </figure>
        )}
        <div class="prose-content">
          <slot />
        </div>
      </article>
    </main>
    <Foot />
  </body>
</html>

<style is:inline>
  body.blog-article { --veil: rgba(18, 18, 18, 0.9); }
  .post { padding: calc(72px + clamp(24px, 5vw, 80px)) var(--m) 0; }
  .post article { max-width: 1120px; margin-inline: auto; }
  .post h1 { font-size: clamp(1.9rem, 1rem + 4.6vw, 4.25rem); line-height: 1.08; overflow-wrap: break-word; }
  .post-meta { display: flex; gap: 20px; margin-top: 28px; color: var(--muted); font-size: var(--step-small); }
  .post-hero { margin: 48px 0 0; }
  .post-hero img { width: 100%; height: auto; }
  .post-hero figcaption { margin-top: 12px; color: var(--muted); font-size: var(--step-small); }
  .prose-content { max-width: 100ch; margin-top: 56px; line-height: 1.7; overflow-wrap: break-word; }
  .prose-content p { margin: 0 0 1.35em; }
  .prose-content h2, .prose-content h3, .prose-content h4 { font-family: var(--head); font-weight: 400; letter-spacing: -0.015em; line-height: 1.1; margin: 2.2em 0 0.7em; }
  .prose-content h2 { font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.5rem); }
  .prose-content h3 { font-size: clamp(1.4rem, 1.1rem + 1vw, 1.9rem); }
  .prose-content h4 { font-size: 1.25rem; }
  .prose-content a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  .prose-content a:hover { text-decoration: none; }
  .prose-content ul, .prose-content ol { margin: 0 0 1.35em; padding-left: 1.5em; }
  .prose-content ul { list-style: disc; } .prose-content ol { list-style: decimal; }
  .prose-content li { margin-bottom: 0.4em; }
  .prose-content blockquote { margin: 1.75em 0; padding: 0.4em 0 0.4em 1.5em; border-left: 3px solid var(--ink); color: var(--muted); font-style: italic; }
  .prose-content pre { padding: 1.25em; overflow-x: auto; margin: 1.75em 0; border-radius: 0; font-size: 0.9rem; }
  .prose-content code, .prose-content pre { font-family: var(--mono); }
  .prose-content code:not(pre code) { background: var(--surface); padding: 0.15em 0.4em; font-size: 0.875em; }
  .prose-content table { width: 100%; border-collapse: collapse; margin: 1.75em 0; font-size: 0.9375rem; display: block; overflow-x: auto; }
  .prose-content th, .prose-content td { padding: 0.55em 0.8em; border: 1px solid #2b241d; text-align: left; }
  .prose-content th { background: var(--surface); font-weight: 500; }
  .prose-content img { max-width: 100%; height: auto; margin: 1.5em 0; }
  .prose-content .katex-display { overflow-x: auto; overflow-y: hidden; }
</style>
